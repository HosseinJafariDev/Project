@page
@model Project.Page.Pages.Auth.SignUp

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="UTF-8"/>

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0"/>

    <title>ثبت نام</title>

    <link rel="stylesheet"
          href="~/css/RegisterStyle.css"/>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>

<body>

<div class="register-container">

    <div class="register-card">

        <h2>ایجاد حساب کاربری</h2>

        <p>اطلاعات خود را تکمیل کنید.</p>

        <form id="frm-register"
              method="post">

            @Html.AntiForgeryToken()

            <div class="row">

                <div class="input-group">

                    <label>نام</label>

                    <input type="text"
                           asp-for="SignUpRequest.FirsName"
                           placeholder="نام">

                </div>

                <div class="input-group">

                    <label>نام خانوادگی</label>

                    <input type="text"
                           asp-for="SignUpRequest.Lastname"
                           placeholder="نام خانوادگی">

                </div>

            </div>

            <div class="input-group">

                <label>نام کاربری</label>

                <input type="text"
                       asp-for="SignUpRequest.Username"
                       placeholder="نام کاربری">

            </div>

            <div class="input-group">

                <label>رمز عبور</label>

                <input type="password"
                       asp-for="SignUpRequest.Password"
                       placeholder="رمز عبور">

            </div>

            <div class="input-group">

                <label>شماره موبایل</label>

                <input type="text"
                       asp-for="SignUpRequest.PhoneNumber"
                       placeholder="09xxxxxxxxx">

            </div>

            <button type="submit">
                ثبت نام
            </button>

        </form>

        <div class="login-link">

            قبلا ثبت نام کرده اید؟

            <a asp-page="/Auth/Login">
                ورود
            </a>

        </div>

    </div>

</div>

<script>
    $("#frm1").submit(function (e) {
        e.preventDefault();
        $.ajax({
            url: "/Auth/SignUp",
            method: "POST",
            data: $("#frm1").serialize(),
            success: function (data) {
                if (data.success) {
                    window.location.href = "/Auth/Login";
                } else {
                    alert(data.message);
                }
            }
        })
    })
</script>
</body>

</html>