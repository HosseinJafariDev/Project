@page
@model Project.Page.Pages.Auth.ForgotPassword

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>بازیابی رمز عبور</title>

    <link rel="stylesheet" href="/css/ForgotPasswordStyle.css">

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
</head>

<body>

<div class="forgot-container">

    <div class="forgot-card">

        <h2>بازیابی رمز عبور</h2>

        <p>
            نام کاربری و رمز عبور جدید را وارد کنید.
        </p>

        <form id="frm-forgot" method="post">

            @Html.AntiForgeryToken()

            <div class="input-group">

                <label>نام کاربری</label>

                <input type="text"
                       asp-for="ForgotPasswordRequest.Username"
                       placeholder="نام کاربری">

            </div>

            <div class="input-group">

                <label>رمز عبور جدید</label>

                <input type="password"
                       asp-for="ForgotPasswordRequest.Password"
                       placeholder="رمز عبور جدید">

            </div>

            <button type="submit">
                ثبت رمز عبور
            </button>

        </form>

        <div class="back-login">

            <a asp-page="/Auth/Login">
                بازگشت به ورود
            </a>

        </div>

    </div>

</div>

<script>

    $("#frm-forgot").submit(function (e) {

        e.preventDefault();

        $.ajax({

            url: "/Auth/ForgotPassword",

            type: "POST",

            data: $(this).serialize(),

            success: function (result) {

                if (result.success) {

                    alert("رمز عبور با موفقیت تغییر کرد.");

                    window.location.href = "/Auth/Login";

                } else {

                    alert(result.message);

                }

            }

        });

    });

</script>

</body>

</html>