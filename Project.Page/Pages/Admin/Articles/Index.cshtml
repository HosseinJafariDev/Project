@page
@model Project.Page.Pages.Admin.Articles.Index

@{
    Layout = "Shared/_Layout";
}

<div class="article-page">

    <div class="page-header">

        <h1>مدیریت مقالات</h1>

        <a asp-page="Create" class="btn-create">
            + ثبت مقاله
        </a>

    </div>

    <table class="article-table">

        <thead>

        <tr>

            <th>ردیف</th>
            <th>عنوان مقاله</th>
            <th>خلاصه</th>
            <th>دسته‌بندی</th>
            <th>تاریخ ثبت</th>
            <th>تاریخ ویرایش</th>
            <th>عملیات</th>

        </tr>

        </thead>

        <tbody>

        @{
            var row = 1;
        }

        @foreach (var article in Model.Articles)
        {
            <tr>

                <td>
                    @row
                </td>

                <td>
                    @article.Title
                </td>

                <td class="article-summary">

                    @{
                        var plainText = Regex.Replace(article.Content, "<.*?>", "");

                        var summary = plainText.Length > 80
                            ? plainText.Substring(0, 80) + "..."
                            : plainText;
                    }

                    @summary

                </td>

                <td>

                    @string.Join(" | ", article.Categories.Select(c => c.Name))

                </td>

                <td>

                    @article.CreatedAt.ToString("yyyy/MM/dd")

                </td>

                <td>

                    @(article.UpdatedAt.HasValue
                        ? article.UpdatedAt.Value.ToString("yyyy/MM/dd")
                        : "-")

                </td>

                <td class="actions">

                    <a asp-page="Edit"
                       asp-route-id="@article.Id"
                       class="btn-edit">
                        ویرایش
                    </a>

                    <form class="frm-delete" method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="Id"
                               value="@article.Id"/>

                        <input type="hidden"
                               name="AuthorId"
                               value="@article.AuthorId"/>

                        <input type="hidden"
                               name="Title"
                               value="@article.Title"/>

                        <input type="hidden"
                               name="Content"
                               value="@article.Content"/>

                        <input type="hidden"
                               name="CreatedAt"
                               value="@article.CreatedAt.ToString("yyyy-MM-ddTHH:mm:ss")"/>

                        <input type="hidden"
                               name="UpdatedAt"
                               value="@(article.UpdatedAt.HasValue
                                          ? article.UpdatedAt.Value.ToString("yyyy-MM-ddTHH:mm:ss")
                                          : "")"/>

                        <input type="hidden"
                               name="Categories"
                               value="@article.Categories"/>

                        <button type="submit"
                                class="btn-delete">
                            حذف
                        </button>

                    </form>


                </td>

            </tr>

            row++;
        }
    
        </tbody>

    </table>


</div>

<script>
    $(".frm-delete").submit(function (e) {
        e.preventDefault();
        if (!confirm("آیا از حذف این مقاله مطمئن هستید؟"))
            return;
        var form = $(this);
        $.ajax({
            url: "/Admin/Articles?handler=Delete",
            method: "post",
            data: form.serialize(),
            success: function (data) {
                if (data) {
                    form.closest("tr").remove();
                    alert("حذف شد")
                }
            }
        })
    })
</script>