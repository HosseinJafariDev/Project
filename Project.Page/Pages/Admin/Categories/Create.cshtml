@page
@model Project.Page.Pages.Admin.Categories.Create

@{
    Layout = "Shared/_Layout";
}

<div class="create-container" xmlns="http://www.w3.org/1999/html">

    <div class="create-card">
        <h2>ثبت دسته‌بندی جدید</h2>
        <p class="subtitle">اطلاعات دسته‌بندی را وارد کنید.</p>
        <form id="frm-sub-add" method="post">
            <div class="form-group">
                <label>نام دسته‌بندی</label>
                <input id="txt-name" type="text" placeholder="علمی"
                       asp-for="CategoryCreateRequest.Name">
            </div>

            <div class="buttons">
                <button class="btn-save" type="submit">
                    ثبت دسته بندی
                </button>

                <a asp-page="/Admin/Categories/Index">
                    بازگشت
                </a>
            </div>
        </form>

    </div>
</div>
<script>
    $("#frm-sub-add").submit(function (e) {
        e.preventDefault();
        console.log($("#frm-sub-add").serialize());
        $.ajax({
            url: "/Admin/Categories/Create?handler=Create",
            method: "POST",
            data: $("#frm-sub-add").serialize(),
            success: function (result) {
                if (result) {
                    alert("ثبت شد")
                    $("#txt-name").val("");
                }
            }

        })
    })
</script>