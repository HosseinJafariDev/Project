@page
@model Project.Page.Pages.Admin.Categories.Create

@{
    Layout = "Shared/_Layout";
}

<div class="create-container">

    <div class="create-card">

        <h2>ثبت دسته‌بندی جدید</h2>
        <p class="subtitle">اطلاعات دسته‌بندی را وارد کنید.</p>

        <div class="form-group">
            <label>نام دسته‌بندی</label>
            <input type="text" placeholder="مثلاً سبزیجات">
        </div>

        <div class="buttons">
            <button class="btn-save">
                ثبت دسته‌بندی
            </button>

            <button class="btn-back">
                بازگشت
            </button>
        </div>

    </div>

</div>